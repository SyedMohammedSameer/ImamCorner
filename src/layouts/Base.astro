---
import '../styles/global.css';
import Header from '../components/Header.astro';
import TabBar from '../components/TabBar.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props { title?: string; description?: string; bare?: boolean; image?: string }
const { title, description = site.tagline, bare = false } = Astro.props;
const fullTitle = title ? `${title} · Imam's Corner` : "Imam's Corner · Islamic Center of Tucson";
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1014" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Imam's Corner" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
      // Staff invite / password-reset links from Netlify Identity land on the home page.
      if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
        const s = document.createElement('script');
        s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        s.onload = () => window.netlifyIdentity.on('login', () => (location.href = '/admin/'));
        document.head.appendChild(s);
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    {!bare && <Header />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}
    <TabBar />
    <script>
      import { initShell } from '../lib/shell';
      initShell();
    </script>
  </body>
</html>
