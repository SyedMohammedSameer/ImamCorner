---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="wrap wrap-narrow page-hero center">
    <p class="eyebrow">404</p>
    <h1>Lost in the desert?</h1>
    <p class="lead">This page has wandered off. Let's get you back on the path.</p>
    <div class="btn-row"><a href="/" class="btn btn-primary"><Icon name="home" />Home</a><a href="/library" class="btn">Library</a><a href="/jummah" class="btn">Jummah</a></div>
  </section>
</Base>
<style>
  .center { text-align: center; display: grid; justify-items: center; }
  .btn-row { justify-content: center; margin-top: 28px; }
</style>
