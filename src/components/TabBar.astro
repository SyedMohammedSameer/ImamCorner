---
import Icon from './Icon.astro';
import { NAV, TABS } from '../data/nav';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const short: Record<string, string> = { '/prayer-times': 'Prayer' };
---
<nav class="tabbar" aria-label="Quick navigation">
  {TABS.map((h) => { const n = NAV.find((x) => x.href === h)!; return (
    <a href={h} aria-current={active(h) ? 'page' : undefined}><Icon name={n.icon} size={23} /><span>{short[h] ?? n.label}</span></a>
  ); })}
  <button type="button" data-menu-open aria-haspopup="dialog"><Icon name="grid" size={23} /><span>More</span></button>
</nav>

<dialog class="sheet" data-menu aria-label="All pages">
  <div class="sheet-inner">
    <div class="sheet-grab" aria-hidden="true"></div>
    <div class="sheet-head">
      <strong>Imam's Corner</strong>
      <button class="btn btn-ghost btn-icon" type="button" data-menu-close aria-label="Close menu"><Icon name="x" /></button>
    </div>
    <ul>
      {NAV.map((n) => (
        <li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>
          <span class="icon-tile"><Icon name={n.icon} /></span>
          <span><strong>{n.label}</strong><small>{n.desc}</small></span>
        </a></li>
      ))}
    </ul>
  </div>
</dialog>

<style>
  .tabbar {
    position: fixed; z-index: 60; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: repeat(5, 1fr);
    height: calc(var(--tab-h) + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);
    background: var(--glass); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-top: 1px solid var(--line);
  }
  .tabbar a, .tabbar button {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
    background: none; border: 0; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: 0;
    -webkit-tap-highlight-color: transparent; transition: color 0.2s;
  }
  .tabbar [aria-current='page'] { color: var(--teal); }
  .tabbar a:active, .tabbar button:active { transform: scale(0.94); }
  @media (min-width: 900px) { .tabbar { display: none; } }

  .sheet {
    padding: 0; border: 0; margin: auto 0 0; width: 100%; max-width: 100%; max-height: 88dvh;
    background: transparent; color: var(--ink);
  }
  @media (min-width: 900px) { .sheet { margin: auto; max-width: 560px; } .sheet .sheet-inner { border-radius: var(--radius-l); } .sheet-grab { display: none; } }
  .sheet::backdrop { background: rgba(10, 8, 6, 0.45); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .sheet[open] .sheet-inner { animation: sheet-up 0.42s var(--ease); }
  @keyframes sheet-up { from { transform: translateY(40px); opacity: 0; } }
  .sheet-inner {
    background: var(--surface); border-radius: var(--radius-l) var(--radius-l) 0 0; box-shadow: var(--shadow-l);
    padding: 8px 12px calc(16px + env(safe-area-inset-bottom)); max-height: 88dvh; overflow: auto;
  }
  .sheet-grab { width: 40px; height: 5px; border-radius: 3px; background: var(--line-strong); margin: 4px auto 6px; }
  .sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 4px 8px 8px; }
  .sheet ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (min-width: 560px) { .sheet ul { grid-template-columns: 1fr 1fr; } }
  .sheet li a { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 14px; }
  .sheet li a:hover, .sheet li a[aria-current='page'] { background: var(--surface-2); }
  .sheet li strong { display: block; font-size: 15.5px; letter-spacing: -0.015em; }
  .sheet li small { display: block; font-size: 13px; color: var(--muted); line-height: 1.3; }
  .sheet .icon-tile { width: 40px; height: 40px; border-radius: 12px; }
</style>
