  </defs>
  <path d="M20 1.5 25.3 7.2 33.1 6.9 32.8 14.7 38.5 20 32.8 25.3 33.1 33.1 25.3 32.8 20 38.5 14.7 32.8 6.9 33.1 7.2 25.3 1.5 20 7.2 14.7 6.9 6.9 14.7 7.2Z" fill="var(--teal)" />
  <circle cx="20" cy="20" r="10.5" fill="url(#lg-sun)" />
  <path d="M9.5 26.5 14 21l3 3 3.5-5 4 4.5 2.5-2 3.5 5Z" fill="#3d3240" opacity=".85" />
  <path d="M23.6 12.2a4 4 0 1 1-4.4 5.9 3.3 3.3 0 1 0 4.4-5.9Z" fill="#fff8ec" />
