# Copy to .env and fill in from your Supabase project. Never commit .env.

# Project Settings → API → Project URL
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings → API Keys → Publishable key (safe for the browser)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Project Settings → API Keys → Secret key (server only: used to send admin invites)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Connect → Session pooler (IPv4; the direct connection is IPv6-only). Only needed locally, to create the tables.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
